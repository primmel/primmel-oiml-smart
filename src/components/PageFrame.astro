---
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle';

const { hasSidebar } = Astro.locals.starlightRoute;
const isHomepage = Astro.url.pathname === '/' || Astro.url.pathname === '';
const showSidebar = hasSidebar && !isHomepage;
const year = new Date().getFullYear();
---

<!-- Reading progress bar (thin accent line at top) -->
{!isHomepage && (
  <div id="reading-progress" aria-hidden="true"></div>
)}

<div class="page sl-flex" class:list={{ 'page--fullwidth': isHomepage }}>
  <header class="header"><slot name="header" /></header>
  {
    showSidebar && (
      <nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
        <MobileMenuToggle />
        <div id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">
            <slot name="sidebar" />
          </div>
        </div>
      </nav>
    )
  }
  <div class="main-frame" class:list={{ 'main-frame--fullwidth': isHomepage }}><slot /></div>

  <!-- Site-wide branded footer -->
  <footer class="site-footer">
    <div class="site-footer__inner">
      <div class="site-footer__brand">
        <div class="site-footer__title">Primmel + OIML SMART</div>
        <div class="site-footer__subtitle">
          The formal foundation and the metamodel for measuring instruments.
        </div>
      </div>
      <div class="site-footer__meta">
        <div class="site-footer__row">
          <span>&copy; {year} OIML SMART.</span>
          <span class="site-footer__separator">·</span>
          <span>Documentation site by Ribose.</span>
        </div>
        <div class="site-footer__row site-footer__row--muted">
          <span>Primmel is an executable modelling language for SMART standards.</span>
        </div>
      </div>
    </div>
  </footer>
</div>

<style>
  @layer starlight.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
    }

    .header {
      z-index: var(--sl-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      height: var(--sl-nav-height);
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      padding-inline-end: var(--sl-nav-pad-x);
      background-color: var(--sl-color-bg-nav);
    }

    :global([data-has-sidebar]) .header {
      padding-inline-end: calc(
        var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
      );
    }

    .sidebar-pane {
      visibility: var(--sl-sidebar-visibility, hidden);
      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset-block: var(--sl-nav-height) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--sl-color-black);
      overflow-y: auto;
      scrollbar-gutter: stable;
    }

    :global([aria-expanded='true']) ~ .sidebar-pane {
      --sl-sidebar-visibility: visible;
    }

    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
    }

    @media (min-width: 50rem) {
      .sidebar-content::after {
        content: '';
        padding-bottom: 1px;
      }
    }

    .main-frame {
      padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
      padding-inline-start: var(--sl-content-inline-start);
      flex: 1;
    }

    @media (min-width: 50rem) {
      :global([data-has-sidebar]) .header {
        padding-inline-end: var(--sl-nav-pad-x);
      }
      .sidebar-pane {
        --sl-sidebar-visibility: visible;
        width: var(--sl-sidebar-width);
        background-color: var(--sl-color-bg-sidebar);
        border-inline-end: 1px solid var(--sl-color-hairline-shade);
      }
    }
  }

  /* Site-wide branded footer */
  .site-footer {
    background: #001e41;
    color: #c8d4e6;
    padding: 2.5rem 1.5rem 2rem;
    margin-top: 4rem;
    font-family: var(--font-body);
    border-top: 0;
  }

  .site-footer__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: end;
  }

  @media (max-width: 760px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  .site-footer__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-bottom: 0.4rem;
    font-variation-settings: 'opsz' 96, 'SOFT' var(--display-soft);
  }

  .site-footer__subtitle {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #c8d4e6;
    max-width: 50ch;
  }

  .site-footer__meta {
    text-align: right;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  @media (max-width: 760px) {
    .site-footer__meta { text-align: left; }
  }

  .site-footer__row {
    color: #89a0bd;
  }

  .site-footer__row--muted {
    color: #6781a3;
    font-style: italic;
    margin-top: 0.4rem;
  }

  .site-footer__separator {
    margin: 0 0.4rem;
    color: #4a608a;
  }
</style>

<script>
  import '../scripts/reading-progress.js';
  import '../scripts/code-blocks.js';
</script>
