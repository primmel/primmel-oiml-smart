---
// Section-aware site title — switches logo and wordmark based on current path.
// Primmel sections (foundation, primmel): Primmel mark + "Primmel" wordmark + indigo tag
// OIML sections (oiml-core, oiml-rec, oiml-cs, platform): OIML SMART mark + "OIML SMART" wordmark + blue tag
// Homepage (overview): OIML SMART mark + "Primmel + OIML SMART" wordmark, no tag

const base = import.meta.env.BASE_URL;
// Strip the deploy base so section detection works under any base path.
const rawPath = Astro.url.pathname;
const path = rawPath.startsWith(base) ? rawPath.slice(base.length - 1) : rawPath;

let section: 'primmel' | 'oiml' | 'overview';
let wordmark: string;
let logoLight: string;
let logoDark: string;
let tag: string | null;

if (path === '/' || path === '' || path.startsWith('/index')) {
  section = 'overview';
  wordmark = 'Primmel + OIML SMART';
  logoLight = `${base}oiml-logo-light.svg`;
  logoDark = `${base}oiml-logo-dark.svg`;
  tag = null;
} else if (
  path.startsWith('/foundation') ||
  path.startsWith('/primmel')
) {
  section = 'primmel';
  wordmark = 'Primmel';
  logoLight = `${base}primmel-logo-light.svg`;
  logoDark = `${base}primmel-logo-dark.svg`;
  tag = 'Foundation';
} else {
  // /oiml-core, /oiml-rec, /oiml-cs, /platform, /shared — all OIML SMART context
  section = 'oiml';
  wordmark = 'OIML SMART';
  logoLight = `${base}oiml-logo-light.svg`;
  logoDark = `${base}oiml-logo-dark.svg`;
  tag = 'SMART';
}
---

<a href={base} class="brand-mark" data-section={section}>
  <img
    class="brand-mark__logo"
    src={logoLight}
    alt=""
    aria-hidden="true"
    loading="eager"
    data-logo-light={logoLight}
    data-logo-dark={logoDark}
  />
  <span class="brand-mark__wordmark">{wordmark}</span>
  {tag && <span class="brand-mark__section-tag">{tag}</span>}
</a>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--color-ink);
    padding: 0.4rem 0;
    font-family: var(--font-display);
    min-width: 0;
  }

  .brand-mark:hover {
    color: var(--color-ink);
  }

  /* Single logo img — JS swaps the src based on data-theme (see script below).
     No CSS display-toggle, no dual-img layering. */
  .brand-mark__logo {
    height: 30px;
    width: auto;
    max-width: 100px;
    flex-shrink: 0;
    object-fit: contain;
    object-position: left center;
  }

  .brand-mark__wordmark {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    font-variation-settings: 'opsz' 36, 'SOFT' var(--display-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .brand-mark__section-tag {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--color-accent-soft);
    border-radius: var(--radius-pill);
    background: var(--color-accent-tint);
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .brand-mark__section-tag { display: none; }
  }
</style>

<script is:inline define:vars={{ base }}>
  // No-flash theme + section detection — runs before paint.
  // Theme comes from localStorage.theme (or prefers-color-scheme).
  // Section comes from the current URL (deploy base stripped).
  (function () {
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const stored = (localStorage.getItem('theme') || '').toLowerCase();
    const theme = stored === 'light' || stored === 'dark' ? stored : (prefersDark ? 'dark' : 'light');
    document.documentElement.dataset.theme = theme;

    const rawPath = window.location.pathname;
    const path = rawPath.startsWith(base) ? rawPath.slice(base.length - 1) : rawPath;
    let section = 'overview';
    if (path.startsWith('/foundation') || path.startsWith('/primmel')) {
      section = 'primmel';
    } else if (
      path.startsWith('/oiml-core') ||
      path.startsWith('/oiml-rec') ||
      path.startsWith('/oiml-cs') ||
      path.startsWith('/platform') ||
      path.startsWith('/shared')
    ) {
      section = 'oiml';
    }
    document.documentElement.dataset.section = section;

    // Swap logo src based on theme. Both light and dark variants are
    // declared on the img as data attributes; pick the right one.
    const logo = document.querySelector('.brand-mark__logo');
    if (logo) {
      const light = logo.getAttribute('data-logo-light');
      const dark = logo.getAttribute('data-logo-dark');
      logo.src = theme === 'dark' ? dark : light;
    }

    // Listen for theme changes and re-swap.
    let lastTheme = theme;
    new MutationObserver(function () {
      const current = document.documentElement.dataset.theme || 'dark';
      if (current !== lastTheme && logo) {
        lastTheme = current;
        const light = logo.getAttribute('data-logo-light');
        const dark = logo.getAttribute('data-logo-dark');
        logo.src = current === 'dark' ? dark : light;
      }
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  })();
</script>

<script is:inline define:vars={{ base }}>
  // No-flash theme + section detection — runs before paint.
  // Theme comes from localStorage.theme (or prefers-color-scheme).
  // Section comes from the current URL (deploy base stripped).
  (function () {
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const stored = (localStorage.getItem('theme') || '').toLowerCase();
    const theme = stored === 'light' || stored === 'dark' ? stored : (prefersDark ? 'dark' : 'light');
    document.documentElement.dataset.theme = theme;

    const rawPath = window.location.pathname;
    const path = rawPath.startsWith(base) ? rawPath.slice(base.length - 1) : rawPath;
    let section = 'overview';
    if (path.startsWith('/foundation') || path.startsWith('/primmel')) {
